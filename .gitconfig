[core]
	autocrlf = input
	excludesfile = ~/.config/git/ignore
	editor = nvim
	symlinks = true
	longpaths = true
	fscache = true
	preloadindex = true
	untrackedCache = true
	pager = sh -c 'command -v delta >/dev/null && delta || less'

[interactive]
	diffFilter = sh -c 'command -v delta >/dev/null && delta --color-only || cat'

[init]
	defaultBranch = main

[fetch]
	recurseSubmodules = false
	prune = true

[alias]
	# Status & Working Tree
	st = status
	files = ls-files
	cleanf = clean -fd

	# Branches & Switching
	co = checkout
	cof = checkout -f
	swf = switch -f
	br = branch
	ba = branch -a
	bd = branch -d
	dm = "!f() { current=$(git symbolic-ref --quiet --short HEAD) || { echo \"error: not on any branch (detached HEAD)\" >&2; return 1; }; git for-each-ref --merged=HEAD --format='%(refname:short)' refs/heads/ | while IFS= read -r branch; do case \"$branch\" in main|master|\"$current\") continue ;; esac; git branch -d -- \"$branch\" || return; done; }; f"
	recent = for-each-ref --count=10 --sort=-committerdate refs/heads/ --format='%(refname:short)'

	# Commits & Resetting
	ci = commit
	amend = commit --amend --no-edit
	unstage = reset HEAD --
	undo = reset --soft HEAD~1
	rho = "!f() { b=$(git branch --show-current); if [ -z \"$b\" ]; then echo \"error: not on any branch (detached HEAD)\" >&2; return 1; fi; git reset --hard \"origin/$b\" --; }; f"

	# Logs & Inspection
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(auto)%d%Creset %s %C(cyan)%cd %Cgreen(%cr)%Creset %C(bold blue)<%an>%Creset' --abbrev-commit --date=format:'%Y-%m-%d %H:%M'
	lo = log --pretty=format:'%C(yellow)%h %C(cyan)%ad %Creset%s' --date=short
	tree = log --graph --pretty=format:'%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit
	last = log -1 HEAD
	stat = show --stat --oneline

	# Diff & Merge
	d = diff
	du = diff @{u}
	dt = difftool
	dtd = difftool --dir-diff
	mt = mergetool

	# Fetch & Submodules
	fap = fetch --all --prune
	gsu = submodule update --init --recursive -f
	sms = submodule status
	smsr = submodule status --recursive
	smr = submodule foreach --recursive git reset --hard
	smrf = submodule foreach --recursive 'git reset --hard && git clean -fd'

[grep]
	lineNumber = true

[rerere]
	enabled = true
	autoupdate = true

[column]
	ui = auto

[branch]
	sort = -committerdate

[diff]
	tool = nvimdiff
	algorithm = histogram
	colorMoved = default

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true

[pull]
	rebase = false

[push]
	autoSetupRemote = true

[rebase]
	autoStash = true

[merge]
	tool = nvimdiff
	conflictstyle = zdiff3

[mergetool]
	prompt = false
	keepBackup = false

[difftool]
	prompt = false

[difftool "nvimdiff"]
	cmd = nvim -d --noplugin \"$LOCAL\" \"$REMOTE\"

[mergetool "nvimdiff"]
	cmd = nvim -d --noplugin \"$LOCAL\" \"$BASE\" \"$REMOTE\" \"$MERGED\" -c 'wincmd J'

[mergetool "vimdiff"]
	layout = "(LOCAL,BASE,REMOTE)/MERGED"

[help]
	autocorrect = prompt

# Refuse to commit with a guessed user@hostname identity. The identity lives in
# ~/.gitconfig.local (created by deploy.sh) or in a per-repo config.
[user]
	useConfigOnly = true

[include]
	path = ~/.gitconfig.local

[oh-my-bash]
	hide-dirty = 1
