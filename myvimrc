" --- Indentation Overrides ---
" Detect renamed memory-tool logs without scanning whole files or overriding code types.
function! s:DetectMemoryToolLog() abort
    if index(['', 'log'], &l:filetype) < 0
        return
    endif
    for l:line in getline(1, min([50, line('$')]))
        if l:line =~# '^=\{8,}\s\+\%(COMPUTE-SANITIZER\|Invalid __\|Uninitialized __\|Misaligned __\|Malloc/Free error\|Leaked \d\+ bytes\|Program hit .*\%(cudaError\|CUDA_ERROR\|CUDA API\)\|Barrier error detected\|Warpgroup MMA sequence error detected\|\%(Error\|ERROR\|WARNING\|Warning\|INFO\): \%(Race reported\|Potential \%(WAW\|WAR\|RAW\) hazard\)\|\%(ERROR\|RACECHECK\) SUMMARY:\)'
            setlocal filetype=computesanitizer
            return
        endif
        if l:line =~# '^==\d\+==\s\+\%(Memcheck,\|Using [Vv]algrind\|Invalid \%(read\|write\|free\)\>\|HEAP SUMMARY:\|LEAK SUMMARY:\|ERROR SUMMARY:\)'
            setlocal filetype=valgrind
            return
        endif
    endfor
    if &l:filetype ==# '' && expand('%:e') ==# 'log'
        setlocal filetype=log
    endif
endfunction

" Filename detection also handles new or empty logs.
augroup valgrind_logs
    autocmd!
    autocmd BufRead,BufNewFile valgrind_*.log setfiletype valgrind
    autocmd BufRead,BufNewFile compute-sanitizer*.log,compute_sanitizer*.log,cuda-memcheck*.log setfiletype computesanitizer
    autocmd BufReadPost * call <SID>DetectMemoryToolLog()
    " Use built-in generic log syntax after trying the specific formats.
    autocmd BufNewFile *.log setfiletype log
augroup END

