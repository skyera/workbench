fcd() {
    local base_dir="${1:-.}"
    local dir
    local list_cmd
    if command -v fd >/dev/null 2>&1; then
        list_cmd="fd --type d --hidden --exclude .git . \"$base_dir\""
    elif command -v fdfind >/dev/null 2>&1; then
        list_cmd="fdfind --type d --hidden --exclude .git . \"$base_dir\""
    else
        list_cmd="find \"$base_dir\" -mindepth 1 -type d -not -path '*/.*' 2>/dev/null"
    fi
    dir=$(eval "$list_cmd" | fzf --layout=reverse --preview 'eza --tree --level=2 --icons=always --color=always {} 2>/dev/null || ls -la {} | head -200') && cd "$dir"
}

fvim() {
    local base_dir="${1:-.}"
    local list_cmd
    if command -v fd >/dev/null 2>&1; then
        list_cmd="fd --type f --hidden --exclude .git . \"$base_dir\""
    elif command -v fdfind >/dev/null 2>&1; then
        list_cmd="fdfind --type f --hidden --exclude .git . \"$base_dir\""
    else
        list_cmd="find \"$base_dir\" -type f -not -path '*/.*' 2>/dev/null"
    fi

    local results
    results=$(eval "$list_cmd" | fzf --multi \
        --prompt="Fuzzy Edit> " \
        --header="[TAB to multi-select, ENTER to open]" \
        --preview="bat -n --color=always --line-range :500 {} 2>/dev/null || head -500 {}" \
        --preview-window=right:60%)
    [[ -z "$results" ]] && return 0

    local files=()
    if [[ -n "$BASH_VERSION" ]]; then
        mapfile -t files <<< "$results"
    elif [[ -n "$ZSH_VERSION" ]]; then
        # shellcheck disable=SC2296
        files=("${(@f)results}")
    fi

    if [[ ${#files[@]} -gt 1 ]]; then
        "${EDITOR:-vi}" -p "${files[@]}"
    elif [[ ${#files[@]} -eq 1 ]]; then
        "${EDITOR:-vi}" "${files[0]}"
    fi
}

fhist() {
    local cmd
    if [[ -n "$BASH_VERSION" ]]; then
        cmd=$(history | fzf +s --tac | sed 's/^[ ]*[0-9]*[ ]*//')
        if [[ -n "$cmd" ]]; then
            READLINE_LINE="$cmd"
            READLINE_POINT=${#cmd}
        fi
    elif [[ -n "$ZSH_VERSION" ]]; then
        cmd=$(fc -l 1 | fzf +s --tac | sed 's/^[ ]*[0-9]*[ ]*//')
        [[ -n "$cmd" ]] && print -z "$cmd"
    fi
}

fkill() {
    local sig="${1:-9}"
    sig="${sig#SIG}"
    sig="${sig#sig}"
    sig="${sig#-}"

    local pid
    pid=$(ps -ef | fzf -m --header-lines=1 --header='[Process List] (TAB to multi-select)' | awk '{print $2}')
    if [[ -n "$pid" ]]; then
        echo "$pid" | xargs kill -"$sig"
    fi
}

up() {
    local d=""
    local limit="${1:-1}"
    local i
    if ! [[ "$limit" =~ ^[0-9]+$ ]] || [[ "$limit" -eq 0 ]]; then
        echo "Usage: up [N] (N must be a positive integer)"
        return 1
    fi
    for ((i=1; i <= limit; i++)); do
        d=$d"../"
    done
    cd "$d"
}

dexec() {
    if ! command -v docker >/dev/null 2>&1; then
        echo "Error: docker is not installed or not in PATH."
        return 1
    fi
    local cid
    if [[ -n "$1" ]] && docker inspect "$1" >/dev/null 2>&1; then
        cid="$1"
    else
        cid=$(docker ps --filter "name=^${USER}" --format "table {{.Names}}\t{{.Image}}\t{{.Status}}" 2>/dev/null | \
            fzf --header-lines=1 --prompt="Docker Exec> " -q "$*" | awk '{print $1}')
    fi
    [[ -z "$cid" ]] && return 0

    docker exec -it -u "$USER" "$cid" bash 2>/dev/null || \
    docker exec -it -u "$USER" "$cid" sh 2>/dev/null || \
    docker exec -it "$cid" bash 2>/dev/null || \
    docker exec -it "$cid" sh
}

fcht() {
    if ! command -v curl >/dev/null 2>&1; then
        echo "Error: curl is not installed or not in PATH."
        return 1
    fi

    local q="$*"
    if [[ -n "$q" ]]; then
        curl -s "https://cht.sh/${q// /+}"
        return $?
    fi

    if ! command -v fzf >/dev/null 2>&1; then
        echo "Usage: cheat <topic> (or install fzf for interactive browsing)"
        return 1
    fi

    local topic
    topic=$(curl -s https://cht.sh/:list | fzf --prompt="Cheat.sh> " --preview 'curl -s "https://cht.sh/{}"')
