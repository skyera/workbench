git_clean_gone() {
    local force=false
    if [[ "$1" == "-f" || "$1" == "--force" || "$1" == "-D" ]]; then
        force=true
    fi

    echo "Fetching and pruning remote tracking branches..."
    git fetch --prune || return 1

    local branches
    branches=$(git branch -vv | awk '/: gone]/{print $1}')

    if [[ -z "$branches" ]]; then
        echo "No stale (gone) branches found."
        return 0
    fi

    if $force; then
        echo "Force deleting stale branches:"
        echo "$branches" | xargs git branch -D
    else
        echo "Safely deleting stale branches (use -f to force):"
        echo "$branches" | xargs git branch -d
    fi
}

alias gbgone='git fetch --prune && git branch -vv | awk '\''/: gone]/{print $1}'\'''
