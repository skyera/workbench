    elif [[ -f "$dir/$theme.theme.bash" ]]; then
        echo "$dir/$theme.theme.bash"
    elif [[ -d "$dir" ]]; then
        local f
        for f in "$dir"/*; do
            if [[ -f "$f" && "$f" == *.theme.* ]]; then
                echo "$f"
                return 0
            fi
