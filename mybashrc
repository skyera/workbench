        echo -e "\033[33m[mybashrc] Note: Core plugins are missing. Please run './deploy.sh' to download and install them.\033[0m"
    fi

    if [ -f "$PLUGINS_DIR/fzf-git.sh/fzf-git.sh" ]; then
        source "$PLUGINS_DIR/fzf-git.sh/fzf-git.sh"
    fi
    if [ -f "$PLUGINS_DIR/forgit/forgit.plugin.sh" ]; then
        _TMP_FIRST_LINE=""
        read -r _TMP_FIRST_LINE < "$PLUGINS_DIR/forgit/forgit.plugin.sh" 2>/dev/null
        if [ "$_TMP_FIRST_LINE" = "forgit.plugin.zsh" ]; then
            source "$PLUGINS_DIR/forgit/forgit.plugin.zsh"
        else
            source "$PLUGINS_DIR/forgit/forgit.plugin.sh"
        fi
        unset _TMP_FIRST_LINE

        if [[ -n "$BASH_VERSION" ]]; then
            export GIT_COMPLETION_CHECKOUT_NO_GUESS=1
            _git_switch_branch() { _git_checkout_branch "$@"; }
            
            _git_exec_path=""
            command -v git >/dev/null 2>&1 && _git_exec_path="$(git --exec-path 2>/dev/null)"

            if ! declare -F _completion_loader >/dev/null 2>&1; then
                for _comp_main in "/usr/share/bash-completion/bash_completion" \
                                  "/etc/bash_completion" \
                                  "$_git_exec_path/../../share/bash-completion/bash_completion" \
                                  "/mingw64/share/bash-completion/bash_completion" \
                                  "/mingw32/share/bash-completion/bash_completion" \
                                  "/usr/local/etc/bash_completion" \
                                  "/opt/homebrew/etc/bash_completion"; do
                    if [ -n "$_comp_main" ] && [ -f "$_comp_main" ]; then
                        source "$_comp_main"
                        break
                    fi
                done
            fi

            _load_git_completion() {
                declare -F __git_complete >/dev/null 2>&1 && return 0
                local exec_path=""
                command -v git >/dev/null 2>&1 && exec_path="$(git --exec-path 2>/dev/null)"
                local s
                for s in "$exec_path/../../share/git/completion/git-completion.bash" \
                         "$exec_path/../../../share/git/completion/git-completion.bash" \
                         "$exec_path/../../share/bash-completion/completions/git" \
                         "/mingw64/share/git/completion/git-completion.bash" \
                         "/mingw32/share/git/completion/git-completion.bash" \
                         "/usr/share/bash-completion/completions/git" \
                         "/usr/share/git-core/git-completion.bash" \
                         "/usr/lib/git-core/git-completion.bash" \
                         "/etc/bash_completion.d/git-completion.bash" \
                         "/opt/homebrew/etc/bash_completion.d/git-completion.bash"; do
                    if [ -n "$s" ] && [ -f "$s" ]; then
                        source "$s"
                        return 0
                    fi
                done
                return 1
            }

            _load_git_completion

            if declare -F __git_complete >/dev/null 2>&1 && declare -F _git >/dev/null 2>&1; then
                __git_complete git _git 2>/dev/null
                __git_complete git.exe _git 2>/dev/null
            fi

            export GIT_OPTIONAL_LOCKS=0

            __git ()
            {
                GIT_OPTIONAL_LOCKS=0 command git ${__git_C_args:+"${__git_C_args[@]}"} ${__git_dir:+--git-dir="$__git_dir"} "$@" 2>/dev/null
            }

            _git_add ()
            {
                case "$cur" in
                --chmod=*)
                    __gitcomp "+x -x" "" "${cur##--chmod=}"
                    return
                    ;;
                --*)
                    __gitcomp_builtin add
                    return
                    ;;
                esac

                local complete_opt="--others --modified --directory --no-empty-directory"
                if test -n "$(__git_find_on_cmdline "-u --update")"; then
                    complete_opt="--modified"
                fi
                if test -n "$(__git_find_on_cmdline "-f --force")"; then
                    complete_opt="$complete_opt --ignored"
                fi
                GIT_OPTIONAL_LOCKS=0 __git_complete_index_file "$complete_opt"
            }

            if ! declare -F _completion_loader >/dev/null 2>&1; then
                _completion_loader() {
                    local cmd="$1"
                    local _gexec=""
                    command -v git >/dev/null 2>&1 && _gexec="$(git --exec-path 2>/dev/null)"
                    if [[ "$cmd" == "git" ]] || [[ "$cmd" == "git.exe" ]] || ! declare -F __git_complete >/dev/null 2>&1; then
                        _load_git_completion && return 0
                    fi
                    for _comp_dir in "/usr/share/bash-completion/completions" \
                                     "$_gexec/../../share/bash-completion/completions" \
                                     "/mingw64/share/bash-completion/completions" \
                                     "/mingw32/share/bash-completion/completions"; do
                        if [ -n "$_comp_dir" ] && [ -f "$_comp_dir/$cmd" ]; then
                            source "$_comp_dir/$cmd"
                            return 0
                        fi
                    done
                    return 1
                }
            fi

            [ -f "$PLUGINS_DIR/forgit/completions/git-forgit.bash" ] && source "$PLUGINS_DIR/forgit/completions/git-forgit.bash"
        elif [[ -n "$ZSH_VERSION" ]]; then
            : # Zsh completion for forgit is autoloaded via fpath
        fi
    fi
fi

