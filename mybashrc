}

switch_starship_theme() {
    local preset="$1"
    if ! command -v starship >/dev/null 2>&1; then
        echo "Error: starship is not installed."
        return 1
    fi

    if [[ -z "$preset" ]]; then
        if [[ -t 0 ]] && command -v fzf >/dev/null 2>&1; then
            local choice border_opt height_opt pointer_opt
            border_opt="$(_get_fzf_border_opt)"
            height_opt="$(_get_fzf_height_opt 15)"
            pointer_opt="$(_get_fzf_pointer_opt)"
            choice=$(printf "%b\n" \
                "catppuccin-powerline\t✦ Catppuccin Mocha Powerline Pills ()\ntokyo-night\t🌌 Tokyo Night Powerline Pills ()\ngruvbox-rainbow\t🌈 Retro Gruvbox Rainbow Arrows ()\npastel-powerline\t🎨 Soft Pastel Arrows ()\npure-preset\t⚡ Minimalist 2-line prompt (Pure Zsh style)\nbracketed-segments\t📦 Clean bracketed segments [dir] [git]\njetpack\t🚀 High-contrast bold layout\nplain-text-symbols\t🔤 Clean Unicode text (No Nerd Fonts)\nno-nerd-font\t💻 Pure ASCII fallback" | \
                fzf --reverse \
                    $border_opt \
                    $height_opt \
                    $pointer_opt \
                    --delimiter='\t' \
                    --with-nth=1,2 \
                    --prompt="❯ " \
                    --header="⚡ Select Starship Preset/Theme" \
                    --preview-window=hidden | cut -f1)
            [[ -z "$choice" ]] && return 0
            preset="$choice"
        else
            echo "Usage: switch_starship_theme [preset_name]"
            echo "Available presets: $(starship preset --list 2>/dev/null | tr '\n' ' ')"
            return 0
        fi
    fi

    local target_config="${STARSHIP_CONFIG:-$HOME/.config/starship.toml}"
    mkdir -p "$(dirname "$target_config")"
    if starship preset "$preset" -o "$target_config" -f 2>/dev/null; then
        if grep -q "^\[git_status\]" "$target_config"; then
            sed -i "/^\[git_status\]/a disabled = true" "$target_config"
        else
            printf "\n[git_status]\ndisabled = true\n" >> "$target_config"
        fi
        if [[ -d "$HOME/test/utils/.config" ]]; then
            cp "$target_config" "$HOME/test/utils/.config/starship.toml" 2>/dev/null
        fi
        echo "Switched Starship preset to: $preset"
        if [[ "$SH_PROMPT_STYLE" != "starship" ]]; then
            switch_prompt starship
        elif declare -f starship_precmd >/dev/null 2>&1; then
            starship_precmd
        fi
    else
        echo "Error: Failed to apply Starship preset '$preset'"
        return 1
    fi
}

_STARSHIP_PRESETS_CACHE=""
_switch_starship_theme_completion() {
    [[ -z "$BASH_VERSION" ]] && return 0
    local cur="${COMP_WORDS[COMP_CWORD]}"
    if command -v starship >/dev/null 2>&1; then
        [[ -z "$_STARSHIP_PRESETS_CACHE" ]] && _STARSHIP_PRESETS_CACHE="$(starship preset --list 2>/dev/null)"
        COMPREPLY=($(compgen -W "$_STARSHIP_PRESETS_CACHE" -- "$cur"))
    fi
}
if [[ -n "$BASH_VERSION" ]]; then
    complete -F _switch_starship_theme_completion switch_starship_theme
fi

switch_theme() {
    local target="$1"

    if [[ "$target" == "starship" ]]; then
        if [[ "$SH_PROMPT_STYLE" != "starship" ]]; then
            switch_prompt starship || return 1
        fi
        shift
        if [[ $# -gt 0 ]]; then
            switch_starship_theme "$@"
        elif [[ -t 0 ]] && command -v fzf >/dev/null 2>&1; then
            switch_starship_theme
        fi
        return 0
    elif [[ "$target" == "oh-my-bash" || "$target" == "omb" ]]; then
        if [[ "$SH_PROMPT_STYLE" != "oh-my-bash" ]]; then
            switch_prompt oh-my-bash || return 1
        fi
        shift
        if [[ $# -gt 0 && "$1" != "oh-my-bash" && "$1" != "omb" && "$1" != "starship" && "$1" != "custom" ]]; then
            switch_theme "$@"
        fi
        return 0
    elif [[ "$target" == "custom" || "$target" == "my" ]]; then
        switch_prompt custom
        return 0
    fi

    if [[ "$SH_PROMPT_STYLE" == "starship" ]]; then
        switch_starship_theme "$@"
        return $?
    fi

    local theme="$target"
    export OSH=${OSH:-$HOME/.oh-my-bash}
    if [[ ! -d "$OSH/themes" ]]; then
        echo "Error: Oh-My-Bash themes directory not found at $OSH/themes"
        return 1
    fi

    if [[ -z "$theme" ]]; then
        if [[ -t 0 ]] && command -v fzf >/dev/null 2>&1; then
            local border_opt height_opt pointer_opt
            border_opt="$(_get_fzf_border_opt)"
            height_opt="$(_get_fzf_height_opt 15)"
            pointer_opt="$(_get_fzf_pointer_opt)"
            theme=$( (cd "$OSH/themes" 2>/dev/null && find . -maxdepth 1 -mindepth 1 -type d -exec basename {} \;) | sort | \
                fzf --header="⚡ Select Oh-My-Bash Theme (Active: ${OSH_THEME:-font})" \
                    --reverse \
                    $border_opt \
                    $height_opt \
                    $pointer_opt \
                    --prompt="❯ " \
                    --preview-window=hidden)
            [[ -z "$theme" ]] && return 0
        else
            echo "Usage: switch_theme [theme_name | starship | oh-my-bash | custom]"
            echo "Current theme: ${OSH_THEME:-font}"
            return 0
        fi
    fi

    local theme_script
    theme_script=$(_get_omb_theme_script "$OSH" "$theme")

    if [[ -n "$theme_script" && -f "$theme_script" ]]; then
        export OSH_THEME="$theme"
        export SCM_GIT_SHOW_MINIMAL_INFO=true
        export SCM_GIT_SHOW_REMOTE_INFO=false
        export SCM_GIT_SHOW_DETAILS=false
        export SCM_GIT_DISABLE_UNTRACKED_DIRTY=true
        export SCM_GIT_IGNORE_UNTRACKED=true
        if ! declare -f _omb_util_add_prompt_command >/dev/null 2>&1 && [[ -f "$OSH/oh-my-bash.sh" ]]; then
            plugins=($OMB_PLUGINS)
            aliases=($OMB_ALIASES)
            completions=($OMB_COMPLETIONS)
            source "$OSH/oh-my-bash.sh" 2>/dev/null
        else
            source "$theme_script" 2>/dev/null
        fi
        _apply_overrides
        echo "Switched Oh-My-Bash theme to: $theme"
    else
        echo "Error: Theme '$theme' not found in $OSH/themes/"
        return 1
    fi
}

_switch_theme_completion() {
    [[ -z "$BASH_VERSION" ]] && return 0
    local cur="${COMP_WORDS[COMP_CWORD]}"
    if [[ "$SH_PROMPT_STYLE" == "starship" ]]; then
        _switch_starship_theme_completion
        return 0
    fi
    local osh_dir="${OSH:-$HOME/.oh-my-bash}"
    if [[ -d "$osh_dir/themes" ]]; then
        local themes
        themes=$(cd "$osh_dir/themes" 2>/dev/null && find . -maxdepth 1 -mindepth 1 -type d -exec basename {} \;)
        COMPREPLY=($(compgen -W "$themes starship oh-my-bash custom omb" -- "$cur"))
    fi
}
if [[ -n "$BASH_VERSION" ]]; then
    complete -F _switch_theme_completion switch_theme st
fi

