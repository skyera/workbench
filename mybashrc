# =============================================================================
# 1. ENVIRONMENT & PATHS
# =============================================================================

# Configuration options for prompt selection
if [[ -z "$SH_PROMPT_STYLE" ]]; then
    _host="${HOSTNAME:-$(hostname 2>/dev/null)}"
    if [[ -n "$_host" && -f "$HOME/.prompt_style.$_host" ]]; then
        _saved_prompt_style="$(cat "$HOME/.prompt_style.$_host" 2>/dev/null)"
        [[ -n "$_saved_prompt_style" ]] && SH_PROMPT_STYLE="$_saved_prompt_style"
    fi
fi
SH_PROMPT_STYLE=${SH_PROMPT_STYLE:-"custom"} # options: "custom", "oh-my-bash", or "starship"
OSH_THEME=${OSH_THEME:-"font"}             # oh-my-bash theme to use
export GIT_PS1_FAST=${GIT_PS1_FAST:-true}  # Enable ultra-fast prompt (skips git status / git diff calls)

export STARSHIP_CONFIG="${STARSHIP_CONFIG:-$HOME/.config/starship.toml}"
[[ "$TERM" == "dumb" || -z "$TERM" ]] && export TERM="xterm-256color"

# Customize what oh-my-bash loads when active:
OMB_PLUGINS=${OMB_PLUGINS:-"git bash-preexec"}
OMB_ALIASES=${OMB_ALIASES:-"general"}
OMB_COMPLETIONS=${OMB_COMPLETIONS:-"git npm pip"}

# PATH: Safely add to PATH without creating duplicate entries upon sourcing/reloading
[[ ":$PATH:" != *":$HOME/bin:"* ]] && export PATH="$HOME/bin:$PATH"
[[ ":$PATH:" != *":$HOME/.local/share/forgit/bin:"* ]] && export PATH="$HOME/.local/share/forgit/bin:$PATH"
export FORGIT_INSTALL_DIR="$HOME/.local/share/forgit"

# Tool configs
export RIPGREP_CONFIG_PATH=$HOME/.ripgreprc
export PROMPT_DIRTRIM=2
export LIBGL_ALWAYS_SOFTWARE=1
export CONDA_CHANGEPS1=false

# Safely prepend include and library paths without duplicates or trailing colons (POSIX / Zsh compatible)
_add_path_to_var() {
    local var_name="$1"
    local dir_path="$2"
    if [[ -d "$dir_path" ]]; then
        local current_val=""
        eval "current_val=\"\$$var_name\""
        if [[ ":$current_val:" != *":$dir_path:"* ]]; then
            if [[ -z "$current_val" ]]; then
                eval "$var_name=\"\$dir_path\""
            else
                eval "$var_name=\"\$dir_path:\$current_val\""
            fi
            export "$var_name"
        fi
    fi
}

for _p in "$HOME/test/doctest/doctest" \
          "$HOME/test/nanobench/src/include" \
          "$HOME/test/FakeIt/single_header/doctest" \
          "$HOME/test/json/single_include" \
          "$HOME/test/stb" \
          "$HOME/test/LuaBridge/Source" \
          "$HOME/test/luajit/src"; do
    _add_path_to_var CPLUS_INCLUDE_PATH "$_p"
done
_add_path_to_var LIBRARY_PATH "$HOME/test/luajit/src"

# History (shell-agnostic)
export HISTSIZE=10000
export HISTFILESIZE=20000
export HISTCONTROL=ignoreboth:erasedups
if [[ -n "$BASH_VERSION" ]]; then
    shopt -s histappend
elif [[ -n "$ZSH_VERSION" ]]; then
    setopt HIST_APPEND HIST_IGNORE_DUPS HIST_IGNORE_SPACE
fi

# =============================================================================
# 2. SHELL & SYSTEM DETECTION
# =============================================================================

# System detection (avoiding uname subprocess call which is slow on Windows/Git Bash)
_IS_MAC=false
if [[ "$OSTYPE" == "darwin"* ]]; then
    _IS_MAC=true
    if [[ -d "/opt/homebrew/bin" ]]; then
        [[ ":$PATH:" != *":/opt/homebrew/bin:"* ]] && export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
    elif [[ -d "/usr/local/bin" ]]; then
        [[ ":$PATH:" != *":/usr/local/bin:"* ]] && export PATH="/usr/local/bin:$PATH"
    fi
fi

_IS_WINDOWS=false
[[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || "$OSTYPE" == "win32" ]] && _IS_WINDOWS=true

# Windows-specific tool aliases & symlink settings
if $_IS_WINDOWS; then
    command -v nvim.exe >/dev/null 2>&1 && alias nvim='nvim.exe'
    command -v vim.exe >/dev/null 2>&1 && alias vim='vim.exe'
    alias vi='nvim'

    if [ -f "C:/Program Files/Git/usr/bin/file.exe" ]; then
        export YAZI_FILE_ONE="C:/Program Files/Git/usr/bin/file.exe"
    elif [ -f "C:/Program Files (x86)/Git/usr/bin/file.exe" ]; then
        export YAZI_FILE_ONE="C:/Program Files (x86)/Git/usr/bin/file.exe"
    elif [ -f "C:/cygwin64/bin/file.exe" ]; then
        export YAZI_FILE_ONE="C:/cygwin64/bin/file.exe"
    fi

    command -v python.exe >/dev/null 2>&1 && alias python='winpty python.exe'
    command -v python3.exe >/dev/null 2>&1 && alias python3='winpty python3.exe'
    command -v pip.exe >/dev/null 2>&1 && alias pip='winpty pip.exe'

    if command -v mpv.exe >/dev/null 2>&1; then
        alias mpv='winpty mpv.exe'
    elif command -v mpv >/dev/null 2>&1; then
        alias mpv='winpty mpv'
    elif [ -f "/c/ProgramData/chocolatey/lib/mpvio.install/tools/mpv.exe" ]; then
        alias mpv='winpty /c/ProgramData/chocolatey/lib/mpvio.install/tools/mpv.exe'
    fi

    export MSYS="winsymlinks:nativestrict"
fi

# Container detection
is_container() {
    $_IS_WINDOWS && return 1
    $_IS_MAC && return 1
    [ -f /.dockerenv ] || [ -f /.containerenv ] || { [ -f /proc/1/cgroup ] && grep -q "docker\|lxc\|kubepods" /proc/1/cgroup 2>/dev/null; } || [ -n "$CONTAINER" ] || [ -n "$KUBERNETES_SERVICE_HOST" ]
}

_IS_CONTAINER=false
is_container && _IS_CONTAINER=true

# Editor & Tool detection (cached)
if [[ -z "$_EDITOR" ]]; then
    if command -v nvim >/dev/null 2>&1; then
        _EDITOR="nvim"
    elif command -v vim >/dev/null 2>&1; then
        _EDITOR="vim"
    else
        _EDITOR="vi"
    fi
fi
export EDITOR="$_EDITOR"
export VISUAL="$EDITOR"

if [[ -z "$_NEOVIM_BIN" ]]; then
    if $_IS_WINDOWS; then
        if command -v nvim.exe >/dev/null 2>&1; then
            _NEOVIM_BIN="nvim.exe"
        fi
    else
        if command -v nvim >/dev/null 2>&1; then
            _NEOVIM_BIN="nvim"
        fi
    fi
fi
export NEOVIM_BIN="$_NEOVIM_BIN"

# Clear any existing git alias before function definition to prevent parse errors on reload
unalias git 2>/dev/null

# Optimize git commands on WSL mounted Windows drives by routing to git.exe
if [[ -n "$WSL_DISTRO_NAME" ]]; then
    git() {
        local f
        if [[ -n "$BASH_VERSION" ]]; then
            for f in "${FUNCNAME[@]}"; do
                if [[ "$f" == "__git_ps1" || "$f" == "_set_bash_prompt_vars" || "$f" == __git* || "$f" == _git* ]]; then
                    command git "$@"
                    return
                fi
            done
        elif [[ -n "$ZSH_VERSION" ]]; then
            for f in "${funcstack[@]}"; do
                if [[ "$f" == "vcs_info" || "$f" == "precmd_vcs_info" || "$f" == _git* ]]; then
                    command git "$@"
                    return
                fi
            done
        fi

        if [[ "$PWD" == /mnt/* ]] && command -v git.exe >/dev/null 2>&1; then
            git.exe "$@"
        else
            command git "$@"
        fi
    }
fi

# Git configuration overrides for containers or old git versions
if $_IS_WINDOWS; then
    _GIT_SUPPORTS_ZDIFF3=true
else
    _GIT_VERSION=$(git version 2>/dev/null)
    _GIT_VERSION=${_GIT_VERSION#git version }
    IFS='.' read -r _GIT_MAJOR _GIT_MINOR _rest <<< "$_GIT_VERSION"
    _GIT_MAJOR=${_GIT_MAJOR:-0}
    _GIT_MINOR=${_GIT_MINOR:-0}

    if [ "$_GIT_MAJOR" -lt 2 ] || { [ "$_GIT_MAJOR" -eq 2 ] && [ "$_GIT_MINOR" -lt 35 ]; }; then
        _GIT_SUPPORTS_ZDIFF3=false
    else
        _GIT_SUPPORTS_ZDIFF3=true
    fi
fi

if $_IS_CONTAINER || ! $_GIT_SUPPORTS_ZDIFF3; then
    _GIT_EXTRA_ARGS=""
    if ! $_GIT_SUPPORTS_ZDIFF3; then
        _GIT_EXTRA_ARGS="$_GIT_EXTRA_ARGS -c merge.conflictstyle=diff3"
    fi
    if [ "$_GIT_MAJOR" -lt 2 ] || { [ "$_GIT_MAJOR" -eq 2 ] && [ "$_GIT_MINOR" -lt 37 ]; }; then
        _GIT_EXTRA_ARGS="$_GIT_EXTRA_ARGS -c push.autoSetupRemote=false"
    fi
    
    if [ -n "$_GIT_EXTRA_ARGS" ]; then
        alias git="git $_GIT_EXTRA_ARGS"
    fi
fi

if ! $_IS_CONTAINER && command -v delta >/dev/null 2>&1; then
    export GIT_PAGER="delta"
else
    export GIT_PAGER="less"
fi

# =============================================================================
# 3. PROMPT & THEMES
# =============================================================================

_git_branch_fast() {
    local b
    b=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)
    [[ -n "$b" ]] && echo "$b"
}

# Unicode prompt character check
_PROMPT_CHAR="\$"
if [[ "$LANG" == *".UTF-8"* || "$LANG" == *".utf8"* || "$LC_ALL" == *".UTF-8"* ]]; then
    _PROMPT_CHAR="❯"
fi

# Pastel palette colors for custom prompt
if [[ -n "$ZSH_VERSION" ]]; then
    _PC_RED="%F{203}"
    _PC_MINT="%F{85}"
    _PC_SKY="%F{117}"
    _PC_LAVENDER="%F{141}"
    _PC_AMBER="%F{214}"
    _PC_SOFT_GREEN="%F{120}"
    _PC_RESET="%f"
else
    _PC_RED="\[\033[38;5;203m\]"
    _PC_MINT="\[\033[38;5;85m\]"
    _PC_SKY="\[\033[38;5;117m\]"
    _PC_LAVENDER="\[\033[38;5;141m\]"
    _PC_AMBER="\[\033[38;5;214m\]"
    _PC_SOFT_GREEN="\[\033[38;5;120m\]"
    _PC_RESET="\[\033[00m\]"
fi

_clean_prompt_command() {
    unset STARSHIP_PROMPT_COMMAND
    if [[ -n "$BASH_VERSINFO" && "${BASH_VERSINFO[0]}" -ge 5 ]] && declare -p PROMPT_COMMAND 2>/dev/null | grep -q "declare -a"; then
        local new_pc=()
        local pc
        for pc in "${PROMPT_COMMAND[@]}"; do
            if [[ "$pc" != *"_render_prompt"* && "$pc" != *"_set_bash_fallback_prompt"* && "$pc" != *"_omb_util_prompt_command_hook"* && "$pc" != *"starship"* ]]; then
                pc="${pc#"${pc%%[![:space:];]*}"}"
                pc="${pc%"${pc##*[![:space:];]}"}"
                [[ -n "$pc" ]] && new_pc+=("$pc")
            fi
        done
        if [[ ${#new_pc[@]} -eq 0 ]]; then
            unset PROMPT_COMMAND
        else
            PROMPT_COMMAND=("${new_pc[@]}")
        fi
    else
        local cmd new_str=""
        local raw="${PROMPT_COMMAND//$'\n'/;}"
        local cmds=()
        if [[ -n "$BASH_VERSION" ]]; then
            IFS=";" read -ra cmds <<< "$raw"
        elif [[ -n "$ZSH_VERSION" ]]; then
            cmds=("${(s:;:)raw}")
        fi
        for cmd in "${cmds[@]}"; do
            cmd="${cmd#"${cmd%%[![:space:]]*}"}"
            cmd="${cmd%"${cmd##*[![:space:]]}"}"
            if [[ -n "$cmd" && "$cmd" != *"_render_prompt"* && "$cmd" != *"_set_bash_fallback_prompt"* && "$cmd" != *"_omb_util_prompt_command_hook"* && "$cmd" != *"starship"* ]]; then
                if [[ -z "$new_str" ]]; then
                    new_str="$cmd"
                else
                    new_str="$new_str; $cmd"
                fi
            fi
        done
        PROMPT_COMMAND="$new_str"
    fi
}

_load_starship_init() {
    if command -v starship >/dev/null 2>&1; then
        local sh_name="bash"
        [[ -n "$ZSH_VERSION" ]] && sh_name="zsh"
        eval "$(starship init "$sh_name" 2>/dev/null)"
    fi
}

if [[ "$SH_PROMPT_STYLE" == "oh-my-bash" && -n "$BASH_VERSION" ]]; then
    export OSH=$HOME/.oh-my-bash
    if [ ! -d "$OSH" ]; then
        if command -v git >/dev/null 2>&1; then
            echo -e "\033[32m[mybashrc] ~/.oh-my-bash not found. Automatically cloning oh-my-bash...\033[0m"
            git clone --depth=1 https://github.com/ohmybash/oh-my-bash.git "$OSH"
        else
            echo -e "\033[31m[mybashrc] Error: git is required to download oh-my-bash.\033[0m"
        fi
    fi
    
    if [ -f "$OSH/oh-my-bash.sh" ]; then
        plugins=($OMB_PLUGINS)
        aliases=($OMB_ALIASES)
        completions=($OMB_COMPLETIONS)
        export SCM_GIT_SHOW_MINIMAL_INFO=true
        export SCM_GIT_SHOW_REMOTE_INFO=false
        export SCM_GIT_SHOW_DETAILS=false
        export SCM_GIT_DISABLE_UNTRACKED_DIRTY=true
        export SCM_GIT_IGNORE_UNTRACKED=true
        source "$OSH/oh-my-bash.sh"
    else
        echo -e "\033[33m[mybashrc] Note: oh-my-bash could not be loaded. Falling back to custom prompt.\033[0m"
        SH_PROMPT_STYLE="custom"
    fi
elif [[ "$SH_PROMPT_STYLE" == "starship" ]]; then
    if command -v starship >/dev/null 2>&1; then
        _clean_prompt_command
        _load_starship_init
    else
        echo -e "\033[33m[mybashrc] Note: starship is not installed. Run deploy.sh or: curl -sS https://starship.rs/install.sh | sh\033[0m"
        SH_PROMPT_STYLE="custom"
    fi
fi

if [[ -n "$BASH_VERSION" ]]; then
    if ! declare -F __git_ps1 >/dev/null 2>&1; then
        _git_exec_dir=""
        command -v git >/dev/null 2>&1 && _git_exec_dir="$(git --exec-path 2>/dev/null)"
        for _prompt_script in "$_git_exec_dir/../../share/git/completion/git-prompt.sh" \
                              "$_git_exec_dir/../../../share/git/completion/git-prompt.sh" \
                              "/usr/lib/git-core/git-sh-prompt" \
                              "/usr/share/git-core/git-sh-prompt" \
                              "/etc/bash_completion.d/git-prompt" \
                              "/opt/homebrew/etc/bash_completion.d/git-prompt.sh" \
                              "/usr/local/etc/bash_completion.d/git-prompt.sh" \
                              "/Library/Developer/CommandLineTools/usr/share/git-core/git-sh-prompt" \
                              "/etc/profile.d/git-prompt.sh" \
                              "/mingw64/share/git/completion/git-prompt.sh"; do
            if [ -n "$_prompt_script" ] && [ -f "$_prompt_script" ]; then
                source "$_prompt_script"
                break
            fi
        done
    fi

    if declare -F __git_ps1 >/dev/null 2>&1; then
        export GIT_PS1_SHOWDIRTYSTATE=true
        export GIT_PS1_SHOWSTASHSTATE=true
        export GIT_PS1_SHOWUNTRACKEDFILES=true
        export GIT_PS1_SHOWUPSTREAM="auto"
        export GIT_PS1_STATESEPARATOR=" "
        
        _set_bash_prompt_vars() {
            local exit_code=$?
            if [[ -n "$1" ]]; then
                exit_code=$1
            fi
            
            export GIT_OPTIONAL_LOCKS=0
            if [[ -n "$WSL_DISTRO_NAME" && "$PWD" == /mnt/* ]] || $_IS_WINDOWS || [[ "$GIT_PS1_FAST" == "true" || "$GIT_PS1_FAST" == "1" ]]; then
                GIT_PS1_SHOWDIRTYSTATE=""
                GIT_PS1_SHOWSTASHSTATE=""
                GIT_PS1_SHOWUNTRACKEDFILES=""
                GIT_PS1_SHOWUPSTREAM=""
            else
                GIT_PS1_SHOWDIRTYSTATE=true
                GIT_PS1_SHOWSTASHSTATE=true
                GIT_PS1_SHOWUNTRACKEDFILES=true
                GIT_PS1_SHOWUPSTREAM="auto"
            fi
            
            local red="$_PC_RED" mint="$_PC_MINT" sky="$_PC_SKY"
            local lavender="$_PC_LAVENDER" amber="$_PC_AMBER"
            local soft_green="$_PC_SOFT_GREEN" reset="$_PC_RESET"
            
            local status_indicator=""
            if [ $exit_code -ne 0 ]; then
                status_indicator="${red}[$exit_code] ${reset}"
            fi
            
            local conda_env=""
            if [[ -n "$CONDA_DEFAULT_ENV" && "$CONDA_DEFAULT_ENV" != "base" ]]; then
                conda_env="${soft_green}(${CONDA_DEFAULT_ENV}) ${reset}"
            fi
            
            _PRE="${status_indicator}${conda_env}${mint}\u@\h${reset}:${sky}\w"
            _POST=" ${amber}${_PROMPT_CHAR}${reset} "
            _FORMAT="${lavender} (%s)"
            return $exit_code
        }

        _render_prompt() {
            local exit_code=$?
            _set_bash_prompt_vars $exit_code
            __git_ps1 "$_PRE" "$_POST" "$_FORMAT"
            return $exit_code
        }
    else
        _set_bash_fallback_prompt() {
            local exit_code=$?
            local red="$_PC_RED" mint="$_PC_MINT" sky="$_PC_SKY"
            local lavender="$_PC_LAVENDER" amber="$_PC_AMBER"
            local soft_green="$_PC_SOFT_GREEN" reset="$_PC_RESET"
            
            local status_indicator=""
            if [ $exit_code -ne 0 ]; then
                status_indicator="${red}[$exit_code] ${reset}"
            fi
            
            local conda_env=""
            if [[ -n "$CONDA_DEFAULT_ENV" && "$CONDA_DEFAULT_ENV" != "base" ]]; then
                conda_env="${soft_green}(${CONDA_DEFAULT_ENV}) ${reset}"
            fi
            
            local branch=""
            local branch_name
            if branch_name=$(_git_branch_fast); then
                branch="${lavender} (${branch_name})"
            fi
            
            PS1="${status_indicator}${conda_env}${mint}\u@\h${reset}:${sky}\w${branch} ${amber}${_PROMPT_CHAR}${reset} "
            return $exit_code
        }
    fi

    if [[ "$SH_PROMPT_STYLE" == "custom" ]]; then
        if declare -F __git_ps1 >/dev/null 2>&1; then
            PROMPT_COMMAND="_render_prompt"
        else
            PROMPT_COMMAND="_set_bash_fallback_prompt"
        fi
    fi

elif [[ -n "$ZSH_VERSION" ]]; then
    autoload -Uz vcs_info
    precmd_vcs_info() {
        if [[ -n "$WSL_DISTRO_NAME" && "$PWD" == /mnt/* ]]; then
            zstyle ':vcs_info:*' check-for-changes false
        else
            zstyle ':vcs_info:*' check-for-changes true
        fi
        vcs_info
    }
    precmd_functions+=(precmd_vcs_info)
    
    zstyle ':vcs_info:*' enable git
    zstyle ':vcs_info:*' check-for-changes true
    zstyle ':vcs_info:git:*' formats ' (%b%u%c%m)'
    zstyle ':vcs_info:git:*' actionformats ' (%b|%a%u%c%m)'
    zstyle ':vcs_info:git:*' unstagedstr '*'
    zstyle ':vcs_info:git:*' stagedstr '+'
 
    +vi-git-untracked() {
        if [[ -n "$WSL_DISTRO_NAME" && "$PWD" == /mnt/* ]]; then
            return 0
        fi
        if git status --porcelain 2>/dev/null | grep -q '^\?\?'; then
            hook_com[unstaged]+='%'
        fi
    }

    +vi-git-stash() {
        if [[ -n "$WSL_DISTRO_NAME" && "$PWD" == /mnt/* ]]; then
            return 0
        fi
        if git rev-parse --verify refs/stash >/dev/null 2>&1; then
            hook_com[misc]+='$'
        fi
    }

    +vi-git-upstream() {
        if [[ -n "$WSL_DISTRO_NAME" && "$PWD" == /mnt/* ]]; then
            return 0
        fi
        local count
        if count=$(git rev-list --left-right --count HEAD...@{upstream} 2>/dev/null); then
            local ahead behind
            read -r ahead behind <<<"$count"
            local upstream_status=""
            if (( ahead > 0 && behind > 0 )); then
                upstream_status="<>"
            elif (( ahead > 0 )); then
                upstream_status=">"
            elif (( behind > 0 )); then
                upstream_status="<"
            fi
            [[ -n "$upstream_status" ]] && hook_com[misc]+=" $upstream_status"
        fi
    }
    
    zstyle ':vcs_info:git*+set-message:*' hooks git-upstream git-stash git-untracked
    setopt prompt_subst
    
    _zsh_conda_prompt() {
        if [[ -n "$CONDA_DEFAULT_ENV" && "$CONDA_DEFAULT_ENV" != "base" ]]; then
            echo "%F{120}(${CONDA_DEFAULT_ENV}) %f"
        fi
    }
    
    if [[ "$SH_PROMPT_STYLE" == "custom" ]]; then
        PROMPT='%(?..%F{203}[%?] %f)$(_zsh_conda_prompt)%F{85}%n@%m%f:%F{117}%~%f%F{141}${vcs_info_msg_0_}%f %F{214}$_PROMPT_CHAR%f '
    fi
fi

_get_fzf_border_opt() {
    if [[ -z "${_CACHED_FZF_BORDER_OPT:-}" ]]; then
        if echo "" | fzf --filter="" --border=rounded >/dev/null 2>&1; then
            _CACHED_FZF_BORDER_OPT="--border=rounded"
        else
            _CACHED_FZF_BORDER_OPT="--border"
        fi
    fi
    echo "$_CACHED_FZF_BORDER_OPT"
}

_get_fzf_height_opt() {
    local h="${1:-10}"
    if [[ -z "${_CACHED_FZF_ADAPTIVE_HEIGHT:-}" ]]; then
        if echo "" | fzf --filter="" --height=~10 >/dev/null 2>&1; then
            _CACHED_FZF_ADAPTIVE_HEIGHT="yes"
        else
            _CACHED_FZF_ADAPTIVE_HEIGHT="no"
        fi
    fi
    if [[ "$_CACHED_FZF_ADAPTIVE_HEIGHT" == "yes" ]]; then
        echo "--height=~${h}"
    else
        echo "--height=${h}"
    fi
}

_get_fzf_pointer_opt() {
    if [[ -z "${_CACHED_FZF_POINTER_OPT+x}" ]]; then
        if echo "" | fzf --filter="" --pointer="▶ " >/dev/null 2>&1; then
            _CACHED_FZF_POINTER_OPT='--pointer=▶ '
        else
            _CACHED_FZF_POINTER_OPT=''
        fi
    fi
    echo "$_CACHED_FZF_POINTER_OPT"
}

switch_prompt() {
    local style="$1"
    if [[ -z "$style" ]]; then
        if [[ -t 0 ]] && command -v fzf >/dev/null 2>&1; then
            local choice options_str border_opt height_opt pointer_opt
            border_opt="$(_get_fzf_border_opt)"
            height_opt="$(_get_fzf_height_opt 10)"
            pointer_opt="$(_get_fzf_pointer_opt)"
            if [[ -n "$ZSH_VERSION" ]]; then
                options_str="custom\t✦ Fast pastel prompt (Pure Zsh, zero-subshell Git)\nstarship\t🌌 Modern cross-shell Starship prompt"
            else
                options_str="custom\t✦ Fast pastel prompt (Pure Bash, zero-subshell Git)\noh-my-bash\t🚀 Feature-rich Oh-My-Bash framework (Theme: ${OSH_THEME:-font})\nstarship\t🌌 Modern cross-shell Starship prompt"
            fi
            choice=$(printf "%b\n" "$options_str" | \
                fzf --reverse \
                    $border_opt \
                    $height_opt \
                    $pointer_opt \
                    --delimiter='\t' \
                    --with-nth=1,2 \
                    --prompt="❯ " \
                    --header="⚡ Select Shell Prompt Style (Active: $SH_PROMPT_STYLE)" \
                    --preview-window=hidden | cut -f1)
            [[ -z "$choice" ]] && return 0
            style="$choice"
        else
            echo "Usage: switch_prompt [custom | oh-my-bash | starship]"
            echo "Current style: $SH_PROMPT_STYLE"
            return 0
        fi
    fi

    local target_style=""
    case "$style" in
        starship)
            target_style="starship"
            if ! command -v starship >/dev/null 2>&1; then
                echo -e "\033[33m[mybashrc] starship not found. Installing to $HOME/bin...\033[0m"
                mkdir -p "$HOME/bin"
                if ! curl -sS https://starship.rs/install.sh | sh -s -- --yes -b "$HOME/bin"; then
                    echo -e "\033[31m[mybashrc] Error: failed to install starship.\033[0m"
                    return 1
                fi
                export PATH="$HOME/bin:$PATH"
            fi
            ;;
        oh-my-bash|omb)
            target_style="oh-my-bash"
            export OSH=$HOME/.oh-my-bash
            if [ ! -d "$OSH" ]; then
                if command -v git >/dev/null 2>&1; then
                    echo -e "\033[32m[mybashrc] ~/.oh-my-bash not found. Automatically cloning oh-my-bash...\033[0m"
                    git clone --depth=1 https://github.com/ohmybash/oh-my-bash.git "$OSH"
                else
                    echo -e "\033[31m[mybashrc] Error: git is required to download oh-my-bash.\033[0m"
                    return 1
                fi
            fi
            ;;
        custom|my)
            target_style="custom"
            ;;
        *)
            echo "Usage: switch_prompt [custom | oh-my-bash | starship]"
            echo "Current style: $SH_PROMPT_STYLE"
            return 1
            ;;
    esac

    export SH_PROMPT_STYLE="$target_style"
    local host_name="${HOSTNAME:-$(hostname 2>/dev/null)}"
    [[ -n "$host_name" ]] && printf "%s" "$target_style" >| "$HOME/.prompt_style.$host_name" 2>/dev/null
    echo "Switched prompt style to $target_style. Restarting shell..."

    local target_shell="${SHELL:-bash}"
    [[ -n "$ZSH_VERSION" ]] && target_shell="zsh"
    [[ -n "$BASH_VERSION" ]] && target_shell="bash"

    SH_PROMPT_STYLE="$target_style" exec "$target_shell" -i
}

toggle_prompt() {
    case "$SH_PROMPT_STYLE" in
        custom) switch_prompt starship ;;
        starship) switch_prompt oh-my-bash ;;
        oh-my-bash|omb) switch_prompt custom ;;
        *) switch_prompt starship ;;
    esac
}

alias sp='switch_prompt'
alias tp='toggle_prompt'
alias spc='switch_prompt custom'
alias sps='switch_prompt starship'
alias spo='switch_prompt oh-my-bash'

if [[ -n "$BASH_VERSION" ]]; then
    complete -W "custom oh-my-bash starship omb my" switch_prompt sp spc sps spo
    if [[ $- == *i* ]]; then
        bind '"\ep": "toggle_prompt\n"' 2>/dev/null
    fi
fi

_get_omb_theme_script() {
    local osh="$1"
    local theme="$2"
    local dir="$osh/themes/$theme"
